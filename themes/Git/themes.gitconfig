[delta "squirrelsong-light"]
    # Squirrelsong Light theme
    # https://sapegin.me/squirrelsong/
    light = true
    commit-decoration-style = ul ol
    file-decoration-style = black overline
    file-added-label = [●]
    file-copied-label = [C]
    file-modified-label = [+]
    file-removed-label = [⛌]
    file-renamed-label = [→]
    file-style = blue bold
    hunk-header-style = bold
    line-numbers = true
    line-numbers-left-format = "{nm:>1}┊"
    line-numbers-left-style = "#8c8792"
    line-numbers-minus-style = red bold
    line-numbers-plus-style = green bold
    line-numbers-right-format = " {np:>1}┊"
    line-numbers-right-style = "#8c8792"
    line-numbers-zero-style = "#8c8792"
    minus-emph-style = normal "#f5e5e4"
    minus-style = normal "#faf3f3"
    plus-emph-style = syntax bold "#dde2d7"
    plus-style = syntax "#f2f4f1"
    whitespace-error-style = red reverse
    zero-style = syntax
    blame-format = "{author:<18} ({commit:>7}) ┊{timestamp:^16}┊ "
    grep-line-number-style = "#8c8792"
    grep-file-style = bold "#3e816e"
    grep-match-word-style = black "#fae1ea"
    grep-separator-symbol = " "

[delta "squirrelsong-dark"]
    # Squirrelsong Dark theme
    # https://sapegin.me/squirrelsong/
    dark = true
    commit-decoration-style = ul ol
    file-decoration-style = black overline
    file-added-label = [●]
    file-copied-label = [C]
    file-modified-label = [+]
    file-removed-label = [⛌]
    file-renamed-label = [→]
    file-style = blue bold
    hunk-header-style = bold
    line-numbers = true
    line-numbers-left-format = "{nm:>1}┊"
    line-numbers-left-style = "#866db0"
    line-numbers-minus-style = red bold
    line-numbers-plus-style = green bold
    line-numbers-right-format = " {np:>1}┊"
    line-numbers-right-style = "#866db0"
    line-numbers-zero-style = "#866db0"
    minus-emph-style = normal "#44283a"
    minus-style = normal "#332239"
    plus-emph-style = syntax bold "#32363a"
    plus-style = syntax "#2d2b39"
    whitespace-error-style = red reverse
    zero-style = syntax
    blame-format = "{author:<18} ({commit:>7}) ┊{timestamp:^16}┊ "
    grep-line-number-style = "#866db0"
    grep-file-style = bold "#4f9593"
    grep-match-word-style = white "#5e375c"
    grep-separator-symbol = " "
