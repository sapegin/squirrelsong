[delta "squirrelsong-light"]
    # Squirrelsong Light theme
    # https://sapegin.me/squirrelsong/
    light = true
    commit-decoration-style = ul ol
    file-decoration-style = black overline
    file-added-label = [●]
    file-copied-label = [C]
    file-modified-label = [+]
    file-removed-label = [⛌]
    file-renamed-label = [→]
    file-style = blue bold
    hunk-header-style = bold
    line-numbers = true
    line-numbers-left-format = "{nm:>1}┊"
    line-numbers-left-style = "{{light:secondaryTextForeground}}"
    line-numbers-minus-style = red bold
    line-numbers-plus-style = green bold
    line-numbers-right-format = " {np:>1}┊"
    line-numbers-right-style = "{{light:secondaryTextForeground}}"
    line-numbers-zero-style = "{{light:secondaryTextForeground}}"
    minus-emph-style = normal "{{light:redDimer}}"
    minus-style = normal "{{light:redDimmest}}"
    plus-emph-style = syntax bold "{{light:greenDimer}}"
    plus-style = syntax "{{light:greenDimmest}}"
    whitespace-error-style = red reverse
    zero-style = syntax
    blame-format = "{author:<18} ({commit:>7}) ┊{timestamp:^16}┊ "
    grep-line-number-style = "{{light:secondaryTextForeground}}"
    grep-file-style = bold "{{light:terminalCyan}}"
    grep-match-word-style = black "{{light:brightPinkDimer}}"
    grep-separator-symbol = " "

[delta "squirrelsong-dark"]
    # Squirrelsong Dark theme
    # https://sapegin.me/squirrelsong/
    dark = true
    commit-decoration-style = ul ol
    file-decoration-style = black overline
    file-added-label = [●]
    file-copied-label = [C]
    file-modified-label = [+]
    file-removed-label = [⛌]
    file-renamed-label = [→]
    file-style = blue bold
    hunk-header-style = bold
    line-numbers = true
    line-numbers-left-format = "{nm:>1}┊"
    line-numbers-left-style = "{{dark:secondaryTextForeground}}"
    line-numbers-minus-style = red bold
    line-numbers-plus-style = green bold
    line-numbers-right-format = " {np:>1}┊"
    line-numbers-right-style = "{{dark:secondaryTextForeground}}"
    line-numbers-zero-style = "{{dark:secondaryTextForeground}}"
    minus-emph-style = normal "{{dark:redDimer}}"
    minus-style = normal "{{dark:redDimmest}}"
    plus-emph-style = syntax bold "{{dark:greenDimer}}"
    plus-style = syntax "{{dark:greenDimmest}}"
    whitespace-error-style = red reverse
    zero-style = syntax
    blame-format = "{author:<18} ({commit:>7}) ┊{timestamp:^16}┊ "
    grep-line-number-style = "{{dark:secondaryTextForeground}}"
    grep-file-style = bold "{{dark:terminalCyan}}"
    grep-match-word-style = white "{{dark:brightPinkDimer}}"
    grep-separator-symbol = " "
