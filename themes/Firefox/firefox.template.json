{
  "manifest_version": 2,
  "version": "1.2.1",
  "name": "Squirrelsong {{name}}",
  "theme": {
    "images": {},
    "properties": {
      "color_scheme": "{{kind}}",
      "content_color_scheme": "{{kind}}"
    },
    "colors": {
      "bookmark_text": "rgb({{titleForeground|rgb}})",
      "button_background_active": "rgb({{hoverBackground|rgb}})",
      "button_background_hover": "rgb({{hoverBackground|rgb}})",
      "frame_inactive": "rgb({{secondaryUiBackground|rgb}})",
      "frame": "rgb({{secondaryUiBackground|rgb}})",
      "icons_attention": "rgb({{activeIcon|rgb}})",
      "icons": "rgb({{icon|rgb}})",
      "ntp_background": "rgb({{textBackground|rgb}})",
      "ntp_card_background": "rgb({{uiBackground|rgb}})",
      "ntp_text": "rgb({{textForeground|rgb}})",
      "popup_border": "rgb({{border|rgb}})",
      "popup_highlight_text": "rgb({{activeForeground|rgb}})",
      "popup_highlight": "rgb({{activeBackground|rgb}})",
      "popup_text": "rgb({{textForeground|rgb}})",
      "popup": "rgb({{uiBackground|rgb}})",
      "sidebar_border": "rgb({{border|rgb}})",
      "sidebar_highlight_text": "rgb({{activeForeground|rgb}})",
      "sidebar_highlight": "rgb({{activeBackground|rgb}})",
      "sidebar_text": "rgb({{textForeground|rgb}})",
      "sidebar": "rgb({{uiBackground|rgb}})",
      "tab_background_text": "rgb({{titleForeground|rgb}})",
      "tab_line": "rgb({{lightBorder|rgb}})",
      "tab_loading": "rgb({{activeIcon|rgb}})",
      "tab_selected": "rgb({{uiBackground|rgb}})",
      "tab_text": "rgb({{titleForeground|rgb}})",
      "toolbar_bottom_separator": "rgb({{border|rgb}})",
      "toolbar_field_border_focus": "rgb({{focusBorder|rgb}})",
      "toolbar_field_border": "rgb({{border|rgb}})",
      "toolbar_field_focus": "rgb({{textBackground|rgb}})",
      "toolbar_field_highlight_text": "rgb({{activeForeground|rgb}})",
      "toolbar_field_highlight": "rgb({{hoverBackground|rgb}})",
      "toolbar_field_text_focus": "rgb({{titleForeground|rgb}})",
      "toolbar_field_text": "rgb({{titleForeground|rgb}})",
      "toolbar_field": "rgb({{textBackground|rgb}})",
      "toolbar_text": "rgb({{icon|rgb}})",
      "toolbar_top_separator": "rgb({{border|rgb}})",
      "toolbar_vertical_separator": "rgb({{border|rgb}})",
      "toolbar": "rgb({{uiBackground|rgb}})"
    }
  }
}
