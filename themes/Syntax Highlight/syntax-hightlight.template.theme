Description="Squirrelsong {{name}}"

Categories = {"{{category}}"}

Default = { Colour="{{textForeground}}" }
Canvas = { Colour="{{textBackground}}" }
Number = { Colour="{{codeValue}}" }
String = { Colour="{{codeString}}" }
Escape = { Colour="{{codeEscapeCharacter}}", Bold=true }
PreProcessor = { Colour="{{codeString}}" }
StringPreProc = { Colour="{{codeString}}" }
BlockComment = { Colour="{{codeComment}}" }
LineComment = { Colour="{{codeComment}}" }
LineNum = { Colour="{{secondaryTextForeground}}" }
Operator = { Colour="{{codeOperator}}" }
Interpolation = { Colour="{{codeEscapeCharacter}}", Bold=true }
Hover = { Colour="", Custom = { { Format = "html", Style = "cursor:help;", Override = false } } }
Error = { Colour="{{codeDeleted}}" }
ErrorMessage = { Colour="{{errorForeground}}", Custom = { { Format = "html", Style = "border:solid 1px red; margin-left: 3em;", Override = false } } }

Keywords = {
	{ Colour="{{codeKeyword}}", Bold=true },
	{ Colour="{{codeType}}" },
	{ Colour="{{codeKeyword}}" },
	{ Colour="{{codeFunction}}" },
	{ Colour="{{codeType}}" },
	{ Colour="{{codeDeleted}}" }
}


SemanticTokenTypes = {
	{ Type = 'keyword', Style = { Colour="{{codeKeyword}}", Bold=true } },
	{ Type = 'type', Style = { Colour="{{codeType}}" } },
	{ Type = 'function', Style = { Colour="{{codeFunction}}", Bold=true } },
	{ Type = 'method', Style = { Colour="{{codeFunction}}" } },
	{ Type = 'class', Style = { Colour="{{codeFunction}}", Bold=true } },
	{ Type = 'struct', Style = { Colour="{{codeType}}" } },
	{ Type = 'parameter', Style = { Colour="{{codeProperty}}" } },
	{ Type = 'variable', Style = { Colour="{{codeVariable}}", Italic=true } },
	{ Type = 'number', Style = { Colour="{{codeValue}}" } },
	{ Type = 'regexp', Style = { Colour="{{codeString}}" } },
	{ Type = 'operator', Style = { Colour="{{codeOperator}}" } },
}
