<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>name</key>
	<string>Squirrelsong ${name}</string>
	<key>settings</key>
	<array>
		<dict>
			<key>settings</key>
			<dict>
				<key>background</key>
				<string>${textBackground}</string>
				<key>caret</key>
				<string>${textForeground}</string>
				<key>foreground</key>
				<string>${textForeground}</string>
				<key>invisibles</key>
				<string>${comment}</string>
				<key>lineHighlight</key>
				<string>${lineHighlightBackground}</string>
				<key>selection</key>
				<string>${selectionBackground}</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Comment</string>
			<key>scope</key>
			<string>comment, invalid.deprecated</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>${comment}</string>
				<key>fontStyle</key>
				<string>${commentStyle}</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>String</string>
			<key>scope</key>
			<string>string</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>${string}</string>
				<key>fontStyle</key>
				<string>${stringStyle}</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Values</string>
			<key>scope</key>
			<string>constant.numeric, constant.language.null, support.constant.property-value</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>${value}</string>
				<key>fontStyle</key>
				<string>${valueStyle}</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Variable</string>
			<key>scope</key>
			<string>variable, constant.character, constant.other, constant.language, entity.other.custom-property</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>${variable}</string>
				<key>fontStyle</key>
				<string>${variableStyle}</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Property</string>
			<key>scope</key>
			<string>meta.property.object, meta.mapping.key, meta.mapping.key.json, support.type.property-name</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>${property}</string>
				<key>fontStyle</key>
				<string>${propertyStyle}</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Keyword</string>
			<key>scope</key>
			<string>keyword</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>${keyword}</string>
				<key>fontStyle</key>
				<string>${keywordStyle}</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Storage type</string>
			<key>scope</key>
			<string>storage.type</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>${keyword}</string>
				<key>fontStyle</key>
				<string>${keywordStyle}</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Storage modifier</string>
			<key>scope</key>
			<string>storage.modifier</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>${keyword}</string>
				<key>fontStyle</key>
				<string>${keywordStyle}</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Class name</string>
			<key>scope</key>
			<string>entity.name.class, entity.other.inherited-class, entity.other.pseudo-class</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>${className}</string>
				<key>fontStyle</key>
				<string>${classNameStyle}</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>At-rule</string>
			<key>scope</key>
			<string>keyword.control.directive</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>${atRule}</string>
				<key>fontStyle</key>
				<string>${atRuleStyle}</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Function name</string>
			<key>scope</key>
			<string>entity.name.function</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>${functionName}</string>
				<key>fontStyle</key>
				<string>${functionNameStyle}</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Function variable</string>
			<key>scope</key>
			<string>variable.function</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>${functionName}</string>
				<key>fontStyle</key>
				<string>${functionNameStyle}</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Function argument</string>
			<key>scope</key>
			<string>variable.parameter</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>${variable}</string>
				<key>fontStyle</key>
				<string>${variableStyle}</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Tag name</string>
			<key>scope</key>
			<string>entity.name.tag</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>${tagName}</string>
				<key>fontStyle</key>
				<string>${tagNameStyle}</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Tag brackets</string>
			<key>scope</key>
			<string>punctuation.definition.tag</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>${tagBrackets}</string>
				<key>fontStyle</key>
				<string>${tagBracketsStyle}</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Tag attribute</string>
			<key>scope</key>
			<string>entity.other.attribute-name</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>${attributeName}</string>
				<key>fontStyle</key>
				<string>${attributeNameStyle}</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Library function</string>
			<key>scope</key>
			<string>support.function</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>${functionName}</string>
				<key>fontStyle</key>
				<string>${functionNameStyle}</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Library constant</string>
			<key>scope</key>
			<string>support.constant</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>${variable}</string>
				<key>fontStyle</key>
				<string>${variableStyle}</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Type</string>
			<key>scope</key>
			<string>support.class, support.type, entity.name.type, entity.name.interface</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>${type}</string>
				<key>fontStyle</key>
				<string>${typeStyle}</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Library type object</string>
			<key>scope</key>
			<string>support.type.object</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>${namespace}</string>
				<key>fontStyle</key>
				<string>${namespaceStyle}</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Library variable</string>
			<key>scope</key>
			<string>support.other.variable</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>${variable}</string>
				<key>fontStyle</key>
				<string>${variableStyle}</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Important 1</string>
			<key>scope</key>
			<string>keyword.other.important</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>${important1}</string>
				<key>fontStyle</key>
				<string>${important1Style}</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Important 2</string>
			<key>scope</key>
			<string>constant.other.character-class.escape</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>${important2}</string>
				<key>fontStyle</key>
				<string>${important2Style}</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Important 3</string>
			<key>scope</key>
			<string>keyword.control.anchor, variable.language.this, entity.other.attribute-name.id</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>${important3}</string>
				<key>fontStyle</key>
				<string>${important3Style}</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Important 4</string>
			<key>scope</key>
			<string>constant.character.entity</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>${important4}</string>
				<key>fontStyle</key>
				<string>${important4Style}</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Control flow</string>
			<key>scope</key>
			<string>keyword.declaration.function.arrow, punctuation.section.interpolation, keyword.operator.combinator</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>${controlFlow}</string>
				<key>fontStyle</key>
				<string>${controlFlowStyle}</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Operator</string>
			<key>scope</key>
			<string>punctuation.definition.group, keyword.operator.quantifier, keyword.operator.assignment</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>${operator}</string>
				<key>fontStyle</key>
				<string>${operatorStyle}</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Escape character</string>
			<key>scope</key>
			<string>constant.character.escape</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>${escapeCharacter}</string>
				<key>fontStyle</key>
				<string>${escapeCharacterStyle}</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Inserted</string>
			<key>scope</key>
			<string>markup.inserted.diff</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>${inserted}</string>
				<key>fontStyle</key>
				<string>${insertedStyle}</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Deleted</string>
			<key>scope</key>
			<string>invalid, markup.deleted.diff</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>${deleted}</string>
				<key>fontStyle</key>
				<string>${deletedStyle}</string>
			</dict>
		</dict>
	</array>
	<key>uuid</key>
	<string>${uuid}</string>
	<key>colorSpaceName</key>
	<string>sRGB</string>
	<key>semanticClass</key>
	<string>${semanticClass}</string>
	<key>author</key>
	<string>Artem Sapegin</string>
	<key>comment</key>
	<string>https:&#x2f;&#x2f;github.com&#x2f;sapegin&#x2f;squirrelsong</string>
</dict>
</plist>
