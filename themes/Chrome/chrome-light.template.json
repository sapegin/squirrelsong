{
  "manifest_version": 3,
  "name": "Squirrelsong Light Theme",
  "description": "A low contrast light UI theme",
  "version": "{{version}}",
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "theme": {
    "colors": {
      "background_tab_inactive": [{{gray160}}],
      "background_tab_incognito_inactive": [{{gray160}}],
      "background_tab_incognito": [{{gray160}}],
      "background_tab": [{{gray160}}],
      "bookmark_text": [{{gray060}}],
      "button_background": [{{gray090}}],
      "button_text": [{{gray060}}],
      "control_background": [{{gray160}}],
      "frame_inactive": [{{gray160}}],
      "frame_incognito_inactive": [{{gray060}}],
      "frame_incognito": [{{gray060}}],
      "frame": [{{gray160}}],
      "ntp_background": [{{gray180}}],
      "ntp_header": [{{gray060}}],
      "ntp_link_underline": [{{blueContrast}}],
      "ntp_link": [{{blueContrast}}],
      "ntp_section_link_underline": [{{blueContrast}}],
      "ntp_section_link": [{{blueContrast}}],
      "ntp_section_text": [{{gray060}}],
      "ntp_section": [{{gray060}}],
      "ntp_text": [{{gray060}}],
      "omnibox_background": [{{gray180}}],
      "omnibox_text": [{{gray060}}],
      "tab_background_text_inactive": [{{gray090}}],
      "tab_background_text_incognito_inactive": [{{gray170}}],
      "tab_background_text_incognito": [{{gray180}}],
      "tab_background_text": [{{gray090}}],
      "tab_text": [{{gray060}}],
      "toolbar_button_icon": [{{gray060}}],
      "toolbar_text": [{{gray060}}],
      "toolbar": [{{gray170}}]
    },
    "tints": {
      "frame": [-1.0, -1.0, -1.0],
      "buttons": [-1.0, -1.0, -1.0],
      "background_tab": [-1.0, -1.0, -1.0]
    },
    "images": {
      "theme_frame": "images/theme_frame.png",
      "theme_toolbar": "images/theme_toolbar_transparent.png",
      "theme_tab_background": "images/theme_toolbar.png"
    }
  }
}
