  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sapegin/squirrelsong.git"
  },
  "type": "module",
  "scripts": {
    "format": "prettier --log-level warn --write --ignore-unknown \"**/*.*\"",
