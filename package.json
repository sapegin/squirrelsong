{
  "name": "squirrelsong",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "Artem Sapegin",
    "url": "https://sapegin.me/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sapegin/squirrelsong.git"
  },
  "type": "module",
  "scripts": {
    "format": "oxfmt",
    "update": "node scripts/update.ts",
    "prepare-extensions": "node scripts/prepare-extensions.ts",
    "prepare-themes": "node scripts/prepare-themes.ts",
    "prepare-vscode-icons": "node scripts/prepare-vscode-icons.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix && oxfmt --write",
    "lint:themes": "node scripts/lint.ts",
    "test": "npm run lint && oxfmt --check && npm run lint:themes"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-config-raccoon": "10.10.0",
    "oxlint-tsgolint": "7.0.2007",
    "typescript": "7.0.2"
  }
}
